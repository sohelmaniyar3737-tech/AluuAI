# Neon PostgreSQL connection string (server only)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Generate a long random secret, e.g. openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret
# AI provider key stays on the server; never use VITE_ prefix
AI_API_KEY=your-ai-provider-api-key
AI_BASE_URL=https://api.groq.com/openai/v1/chat/completions
AI_MODEL=openai/gpt-oss-120b
# Optional: set the frontend origin in production; '*' is convenient for local development
CLIENT_ORIGIN=*
# Render supplies PORT automatically

# Frontend only: set this to the deployed Render API URL for production builds
VITE_API_URL=http://localhost:5000
